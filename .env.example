# Copy to .env.local and fill in. .env.local is gitignored; never commit real values.

# 9router API key (stays on the server).
NINEROUTER_API_KEY=

# Starting family password. Only used until it's changed in Settings (then the database copy wins).
FAMILY_PASSWORD=

# Optional:
# NINEROUTER_BASE_URL=http://127.0.0.1:20128/v1
# DATA_DIR=./data
# NEXT_PUBLIC_GTM_ID=
